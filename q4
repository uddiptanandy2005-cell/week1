import java.util.Scanner;

public class Q4_WarehouseInventoryBalancer {

    static void analyzeInventory(int[] A, int[] B) {

        int sumA = 0;
        int sumB = 0;

        int max = Integer.MIN_VALUE;
        String section = "";
        int index = 0;

        for (int i = 0; i < A.length; i++) {

            sumA += A[i];

            if (A[i] > max) {
                max = A[i];
                section = "Section A";
                index = i;
            }
        }

        for (int i = 0; i < B.length; i++) {

            sumB += B[i];

            if (B[i] > max) {
                max = B[i];
                section = "Section B";
                index = i;
            }
        }

        System.out.println("Section A Total: " + sumA);
        System.out.println("Section B Total: " + sumB);

        if (sumA == sumB)
            System.out.println("Status: Balanced");
        else
            System.out.println("Status: Not Balanced");

        System.out.println("Highest Quantity: " + max);
        System.out.println(section + ", Item " + (index + 1));
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter size: ");
        int n = sc.nextInt();

        int[] A = new int[n];
        int[] B = new int[n];

        System.out.println("Enter Section A:");

        for (int i = 0; i < n; i++)
            A[i] = sc.nextInt();

        System.out.println("Enter Section B:");

        for (int i = 0; i < n; i++)
            B[i] = sc.nextInt();

        analyzeInventory(A, B);
    }
}
